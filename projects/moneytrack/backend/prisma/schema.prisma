generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  EN
  UA
  RU
}

enum Currency {
  UAH
  USD
  EUR
}

enum AccountType {
  BANK
  CASH
  SAVINGS
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum MatchField {
  DESCRIPTION
  MERCHANT
}

enum MatchOperator {
  CONTAINS
  EQUALS
  STARTS_WITH
}

enum ImportStatus {
  PREVIEW
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                      String               @id @default(uuid()) @db.Uuid
  email                   String               @unique
  passwordHash            String
  firstName               String
  lastName                String
  primaryCurrency         Currency             @default(UAH)
  preferredLanguage       Language             @default(EN)
  theme                   String               @default("system")
  timezone                String               @default("Europe/Kyiv")
  notificationPreferences Json                 @default("{\"budgetAlerts\":true,\"recurringPayments\":true}")
  twoFactorEnabled        Boolean              @default(false)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  accounts                Account[]
  transactions            Transaction[]
  categories              Category[]
  budgets                 Budget[]
  goals                   FinancialGoal[]
  recurringPayments       RecurringPayment[]
  categorizationRules     CategorizationRule[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  importJobs              ImportJob[]
  notifications           Notification[]
}

model Account {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  name           String
  type           AccountType
  currency       Currency
  initialBalance Decimal            @db.Decimal(18, 2)
  currentBalance Decimal            @db.Decimal(18, 2)
  description    String?
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurring      RecurringPayment[]

  @@unique([userId, name])
  @@index([userId, archivedAt])
}

model Category {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  parentId    String?              @db.Uuid
  name        String
  kind        CategoryKind
  color       String               @default("#6c63ff")
  icon        String               @default("circle")
  isSystem    Boolean              @default(false)
  archivedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Category?            @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]           @relation("CategoryTree")
  transactions Transaction[]
  budgets     Budget[]
  recurring   RecurringPayment[]
  rules       CategorizationRule[]

  @@unique([userId, parentId, name])
  @@index([userId, kind, archivedAt])
}

model Transaction {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  accountId         String          @db.Uuid
  categoryId        String?         @db.Uuid
  amount            Decimal         @db.Decimal(18, 2)
  currency          Currency
  type              TransactionType
  description       String
  merchant          String?
  notes             String?
  tags              String[]        @default([])
  date              DateTime
  transferGroupId   String?         @db.Uuid
  importFingerprint String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date(sort: Desc)])
  @@index([userId, accountId, date(sort: Desc)])
  @@index([userId, categoryId, date(sort: Desc)])
  @@index([transferGroupId])
  @@index([userId, importFingerprint])
}

model Budget {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  categoryId      String?   @db.Uuid
  amount          Decimal   @db.Decimal(18, 2)
  currency        Currency
  month           DateTime  @db.Date
  alertThresholds Int[]     @default([80, 90, 100])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

model FinancialGoal {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  name          String
  targetAmount  Decimal  @db.Decimal(18, 2)
  currentAmount Decimal  @default(0) @db.Decimal(18, 2)
  currency      Currency
  targetDate    DateTime? @db.Date
  description   String?
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archivedAt])
}

model RecurringPayment {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  accountId     String              @db.Uuid
  categoryId    String?             @db.Uuid
  name          String
  amount        Decimal             @db.Decimal(18, 2)
  currency      Currency
  type          TransactionType     @default(EXPENSE)
  frequency     RecurrenceFrequency
  nextExecution DateTime
  enabled       Boolean             @default(true)
  lastExecutedAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([enabled, nextExecution])
  @@index([userId])
}

model CategorizationRule {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  categoryId  String        @db.Uuid
  matchField  MatchField
  operator    MatchOperator
  matchValue  String
  priority    Int           @default(100)
  enabled     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, enabled, priority])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ImportJob {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  accountId    String       @db.Uuid
  fileName     String
  status       ImportStatus @default(PREVIEW)
  mapping      Json
  previewRows  Json
  importedCount Int         @default(0)
  skippedCount  Int         @default(0)
  invalidCount  Int         @default(0)
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  messageKey String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
}
