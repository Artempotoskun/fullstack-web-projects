# Copy this file to .env. Never commit the resulting .env file.
POSTGRES_DB=autoparts
POSTGRES_USER=autoparts
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://autoparts:replace-with-a-long-random-password@localhost:5432/autoparts?schema=public

PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Generate independently: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Seed-only demo accounts; change these outside a local demo.
SEED_ADMIN_PASSWORD=AdminDemo123!
SEED_USER_PASSWORD=UserDemo123!
